<Window x:Class="Tarkovy.ItemLensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarkovy Item Lens"
        Width="300" Height="220"
        MinWidth="260" MinHeight="180"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#000000"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Assets/brand/tarkovy.ico">
    <Border x:Name="MoveFrame"
            BorderBrush="#FFFFFF"
            BorderThickness="1"
            Padding="7"
            Cursor="SizeAll"
            MouseLeftButtonDown="Header_Drag">
        <Border.Background>
            <SolidColorBrush Color="#FF1A1A1A"/>
        </Border.Background>
        <Grid Cursor="Arrow">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#111111" Cursor="SizeAll" MouseLeftButtonDown="Header_Drag">
                <DockPanel>
                    <Image Source="pack://application:,,,/Assets/brand/tarkovy-icon-256.png"
                           Width="14" Height="14" Margin="8,0,6,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{DynamicResource ItemLens.Title}" VerticalAlignment="Center"
                               FontSize="11" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Right"
                               Text="{DynamicResource ItemScan.Status.Ready}"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="9" Foreground="#8A8A8A"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource ItemLens.Hint}" Foreground="#AAA" FontSize="11"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240"/>
                </StackPanel>
                <Grid x:Name="ResultPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="ItemIcon" Width="48" Height="48" Margin="0,2,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="ItemName" Text="Item" Foreground="#FFF" FontWeight="Bold"
                                   FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ItemShort" Foreground="#888" FontSize="10" Margin="0,2,0,6"/>
                        <TextBlock x:Name="FleaPrice" Foreground="#3DFF7A" FontSize="11"/>
                        <TextBlock x:Name="TraderPrice" Foreground="#9BE7FF" FontSize="11" Margin="0,2,0,0"/>
                        <TextBlock x:Name="SlotPrice" Foreground="#CCC" FontSize="10" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Badges" Foreground="#FFFFFF" FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <TextBlock Grid.Row="2" x:Name="FooterHint" Margin="0,6,0,0" FontSize="9"
                       Foreground="#666" Text="{DynamicResource ItemLens.Footer}" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
