<Window x:Class="Tarkovy.ItemLensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarkovy Item Lens"
        Width="340" Height="340"
        MinWidth="300" MinHeight="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Assets/brand/tarkovy.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid Background="#FF1A1A1A">
        <Border x:Name="MoveFrame"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                Padding="8"
                Background="#FF1A1A1A"
                Cursor="SizeAll"
                MouseLeftButtonDown="Header_Drag">
            <Grid Cursor="Arrow" Background="#FF1A1A1A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#111111" Cursor="SizeAll" MouseLeftButtonDown="Header_Drag"
                        Height="32">
                    <DockPanel Margin="6,0,8,0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/brand/tarkovy-icon-256.png"
                                   Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="ITEM LENS" VerticalAlignment="Center"
                                       FontSize="11" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText"
                                   Text="Pronto"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   FontSize="11"
                                   LineHeight="14"
                                   Foreground="#8A8A8A"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="12,0,0,0"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Border Background="#FF1A1A1A" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="EmptyHintText" Text="Shift+clique no ícone do item."
                                   Foreground="#AAAAAA" FontSize="11"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                    </StackPanel>

                    <Border x:Name="LoadingPanel" Visibility="Collapsed"
                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                            Background="#FF1A1A1A" Padding="12">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MinHeight="120">
                            <Ellipse x:Name="LoadingSpinner" Width="32" Height="32"
                                     Stroke="#FFFFFF" StrokeThickness="3"
                                     StrokeDashArray="16 6" Fill="Transparent"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                    From="0" To="360" Duration="0:0:0.85"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock x:Name="LoadingTitleText"
                                       Text="Identificando item"
                                       Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,12,0,4" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LoadingHintText" Foreground="#888888" FontSize="10"
                                       Text="Capturando ícone…" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="280"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="ResultPanel" Visibility="Collapsed"
                                  Style="{StaticResource DarkQuestScrollViewer}"
                                  Background="#FF1A1A1A">
                        <StackPanel Background="#FF1A1A1A">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="64" Height="64" VerticalAlignment="Top"
                                        Background="#0D0D0D" BorderBrush="#444444" BorderThickness="1">
                                    <Image x:Name="ItemIcon" Stretch="Uniform" Margin="4"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                    <TextBlock x:Name="ItemName" Foreground="#FFFFFF" FontWeight="Bold"
                                               FontSize="14" TextWrapping="Wrap" LineHeight="18"/>
                                    <TextBlock x:Name="ItemShort" Foreground="#888888" FontSize="10"
                                               Margin="0,3,0,4" TextWrapping="Wrap"/>
                                    <WrapPanel x:Name="UsageIcons" Margin="0,0,0,6"/>
                                    <WrapPanel>
                                        <Border Background="#222222" BorderBrush="#444444"
                                                BorderThickness="1" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock x:Name="SizeBadgeText" Foreground="#CCCCCC" FontSize="9"/>
                                        </Border>
                                        <Border Background="#222222" BorderBrush="#444444"
                                                BorderThickness="1" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock x:Name="ConfidenceBadgeText" Foreground="#CCCCCC" FontSize="9"/>
                                        </Border>
                                        <Border Background="#222222" BorderBrush="#444444"
                                                BorderThickness="1" Padding="6,2">
                                            <TextBlock x:Name="ModeBadgeText" Foreground="#CCCCCC" FontSize="9"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,10,0,0" Padding="8,6" Background="#111111"
                                    BorderBrush="#333333" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Flea"
                                               Foreground="#666666" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FleaPrice" Grid.Row="0" Grid.Column="1"
                                               Foreground="#3DFF7A" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Trader"
                                               Foreground="#666666" FontSize="10" Margin="0,4,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TraderPrice" Grid.Row="1" Grid.Column="1"
                                               Foreground="#9BE7FF" FontSize="12" Margin="0,4,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="/ slot"
                                               Foreground="#666666" FontSize="10" Margin="0,4,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SlotPrice" Grid.Row="2" Grid.Column="1"
                                               Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border x:Name="AmmoPanel" Visibility="Collapsed"
                                    Margin="0,10,0,0" Padding="8,6"
                                    Background="#111111" BorderBrush="#333333" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="AmmoPenText" Foreground="#FFFFFF"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AmmoDmgText" Grid.Column="1" Foreground="#CCCCCC"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AmmoCaliberText" Grid.Column="2" Foreground="#888888"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                    <UniformGrid x:Name="AmmoClassHeaders" Columns="6" Margin="0,8,0,2"/>
                                    <UniformGrid x:Name="AmmoRatingRow" Columns="6"/>
                                    <TextBlock x:Name="AmmoVerdict" Foreground="#CCCCCC" FontSize="10"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <TextBlock Grid.Row="2" x:Name="FooterHint" Margin="0,8,0,4" FontSize="9"
                           Foreground="#666666" Text="Preços do tarkov.dev" TextWrapping="Wrap"/>

                <StackPanel Grid.Row="3">
                    <Border x:Name="SearchResultsPanel" Visibility="Collapsed"
                            MaxHeight="148" Margin="0,0,0,4"
                            Background="#0D0D0D" BorderBrush="#444444" BorderThickness="1">
                        <ScrollViewer Style="{StaticResource DarkQuestScrollViewer}"
                                      Background="#0D0D0D">
                            <StackPanel x:Name="SearchResultsList"/>
                        </ScrollViewer>
                    </Border>
                    <Border Background="#111111" BorderBrush="#444444" BorderThickness="1"
                            MouseLeftButtonDown="SearchArea_MouseDown">
                        <Grid MinHeight="28">
                            <TextBox x:Name="ItemSearchBox"
                                     Padding="8,5,28,5"
                                     FontSize="11"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="#E8A317"
                                     Foreground="#FFFFFF"
                                     VerticalContentAlignment="Center"
                                     TextChanged="ItemSearch_Changed"
                                     PreviewKeyDown="ItemSearch_PreviewKeyDown"/>
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Buscar item"
                                       FontSize="11"
                                       Foreground="#666666"
                                       VerticalAlignment="Center"
                                       Margin="8,0,28,0"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="🔍"
                                       FontSize="12"
                                       Foreground="#888888"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
