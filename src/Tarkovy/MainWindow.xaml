<Window x:Class="Tarkovy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tarkovy.Controls"
        xmlns:local="clr-namespace:Tarkovy"
        Title="TARKOVY"
        Height="720" Width="1180"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDeep}"
        Foreground="{StaticResource BrushText}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/brand/tarkovy.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="AppChrome" BorderBrush="{StaticResource BrushAmber}" BorderThickness="1" Background="{StaticResource BrushBgDeep}">
            <Grid x:Name="AppRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="32" Height="32" Margin="0,0,10,0">
                            <Ellipse Stroke="#FFFFFF" StrokeThickness="1.6" Fill="Transparent"/>
                            <Path StrokeThickness="0" Fill="#FFFFFF"
                                  Stretch="Uniform" Width="14" Height="14"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0,14 L 7,0 L 14,14 L 10.5,14 L 7,7 L 3.5,14 Z"/>
                        </Grid>
                        <TextBlock Text="TARKOVY" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushAmber}" FontSize="20" FontWeight="Bold"
                                   FontFamily="{StaticResource HudFont}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="EftTargetLabel" VerticalAlignment="Center" Margin="2,0,10,0"
                                   Foreground="{StaticResource BrushTextDim}" FontSize="10"
                                   ToolTip="{DynamicResource Main.Tooltip.EftTarget}"/>
                        <TextBlock x:Name="AppVersionLabel" Text="Dev 0.1.39" VerticalAlignment="Center" Margin="2,0,6,0"
                                   Foreground="{StaticResource BrushTextDim}" FontSize="11"
                                   WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="SettingsHeaderBtn" Content="⚙" Width="40" Height="32" Click="Settings_Click"
                                Background="Transparent" Foreground="{StaticResource BrushAmber}" BorderThickness="0"
                                FontSize="15" WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand"
                                ToolTip="{DynamicResource Main.Tooltip.Settings}"/>
                        <Button Content="─" Width="40" Height="32" Click="Minimize_Click"
                                Background="Transparent" Foreground="{StaticResource BrushTextDim}" BorderThickness="0"
                                FontSize="14" WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand"
                                ToolTip="{DynamicResource Main.Tooltip.Minimize}"/>
                        <Button x:Name="MaximizeBtn" Content="□" Width="40" Height="32" Click="Maximize_Click"
                                Background="Transparent" Foreground="{StaticResource BrushTextDim}" BorderThickness="0"
                                FontSize="14" WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand"
                                ToolTip="{DynamicResource Main.Tooltip.Maximize}"/>
                        <Button Content="✕" Width="40" Height="32" Click="Close_Click"
                                Background="Transparent" Foreground="{StaticResource BrushTextDim}" BorderThickness="0"
                                FontSize="14" WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand"
                                ToolTip="{DynamicResource Main.Tooltip.Close}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,16,16,8" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource HudLabel}" Text="{DynamicResource Main.Section.Notice}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BrushTextDim}"
                                       Text="{DynamicResource Main.Notice.Body}"/>

                            <TextBlock Style="{StaticResource HudLabel}" Margin="0,16,0,4" Text="{DynamicResource Main.Section.Map}"/>
                            <ComboBox x:Name="MapCombo" SelectionChanged="MapCombo_SelectionChanged"/>

                            <TextBlock Style="{StaticResource HudLabel}" Margin="0,16,0,6" Text="{DynamicResource Main.Section.Markers}"/>
                            <Border Background="#0A0A0A"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    Padding="6,6,6,6">
                                <StackPanel>
                                    <UniformGrid Columns="4" Rows="2">
                                        <CheckBox x:Name="ShowExtractsBox"
                                                  Style="{StaticResource MarkerToggleChip}"
                                                  Content="{DynamicResource Main.Marker.Extracts.Short}"
                                                  ToolTip="{DynamicResource Main.Marker.Extracts}"
                                                  Checked="Markers_Changed" Unchecked="Markers_Changed"/>
                                        <CheckBox x:Name="ShowMinesBox"
                                                  Style="{StaticResource MarkerToggleChip}"
                                                  Content="{DynamicResource Main.Marker.Mines}"
                                                  ToolTip="{DynamicResource Main.Marker.Mines}"
                                                  Checked="Markers_Changed" Unchecked="Markers_Changed"/>
                                        <CheckBox x:Name="ShowSpawnsBox"
                                                  Style="{StaticResource MarkerToggleChip}"
                                                  Content="{DynamicResource Main.Marker.Spawns.Short}"
                                                  ToolTip="{DynamicResource Main.Marker.Spawns}"
                                                  Checked="Markers_Changed" Unchecked="Markers_Changed"/>
                                        <CheckBox x:Name="ShowLabelsBox"
                                                  Style="{StaticResource MarkerToggleChip}"
                                                  Content="{DynamicResource Main.Marker.Labels.Short}"
                                                  ToolTip="{DynamicResource Main.Marker.Labels}"
                                                  Checked="Markers_Changed" Unchecked="Markers_Changed"/>
                                        <CheckBox x:Name="ShowQuestsBox"
                                                  Style="{StaticResource MarkerToggleChip}"
                                                  Content="{DynamicResource Main.Marker.Quests.Short}"
                                                  ToolTip="{DynamicResource Main.Marker.Quests}"
                                                  Checked="Markers_Changed" Unchecked="Markers_Changed"/>
                                        <CheckBox x:Name="ShowLootBox"
                                                  Style="{StaticResource MarkerToggleChip}"
                                                  Content="{DynamicResource Main.Marker.Loot}"
                                                  ToolTip="{DynamicResource Main.Poi.Cat.Loot}"
                                                  IsThreeState="True"
                                                  PreviewMouseLeftButtonDown="PoiMaster_PreviewMouseDown"/>
                                        <CheckBox x:Name="ShowBossesBox"
                                                  Style="{StaticResource MarkerToggleChip}"
                                                  Content="{DynamicResource Main.Marker.Bosses}"
                                                  ToolTip="{DynamicResource Main.Poi.Cat.Enemies}"
                                                  IsThreeState="True"
                                                  PreviewMouseLeftButtonDown="PoiMaster_PreviewMouseDown"/>
                                        <CheckBox x:Name="ShowLocsBox"
                                                  Style="{StaticResource MarkerToggleChip}"
                                                  Content="{DynamicResource Main.Marker.Locs}"
                                                  ToolTip="{DynamicResource Main.Poi.Cat.Locations}"
                                                  IsThreeState="True"
                                                  PreviewMouseLeftButtonDown="PoiMaster_PreviewMouseDown"/>
                                    </UniformGrid>
                                    <Rectangle Height="1" Fill="#2A2A2A" Margin="2,8,2,6"/>
                                    <UniformGrid Columns="3">
                                        <Button x:Name="PoiPresetCleanBtn" Style="{StaticResource PoiPresetBarChip}"
                                                Content="{DynamicResource Main.Poi.Preset.Clean}"
                                                ToolTip="{DynamicResource Main.Poi.Preset.Clean.Tip}"
                                                Click="PoiPreset_Click" Tag="clean"/>
                                        <Button x:Name="PoiPresetRaidBtn" Style="{StaticResource PoiPresetBarChip}"
                                                Content="{DynamicResource Main.Poi.Preset.Raid}"
                                                ToolTip="{DynamicResource Main.Poi.Preset.Raid.Tip}"
                                                Click="PoiPreset_Click" Tag="raid"/>
                                        <Button x:Name="PoiPresetLootBtn" Style="{StaticResource PoiPresetBarChip}"
                                                Content="{DynamicResource Main.Poi.Preset.Loot}"
                                                ToolTip="{DynamicResource Main.Poi.Preset.Loot.Tip}"
                                                Click="PoiPreset_Click" Tag="loot"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,16,0,6" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PanelQuestsBtn" Style="{StaticResource PanelTabButton}"
                                        Content="{DynamicResource Main.Section.Quests}"
                                        Click="PanelTab_Click" Tag="quests"/>
                                <Button x:Name="PanelPoisBtn" Style="{StaticResource PanelTabButton}"
                                        Content="{DynamicResource Main.Section.Pois}"
                                        Click="PanelTab_Click" Tag="pois" Margin="8,0,0,0"/>
                                <Button Style="{StaticResource ShortcutChipInfo}"
                                        Content="i"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Width="20"
                                        Height="20"
                                        Margin="6,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center">
                                    <Button.ToolTip>
                                        <ToolTip MaxWidth="300">
                                            <TextBlock x:Name="PanelHintText" Text="{DynamicResource Main.Quests.Hint}" TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{StaticResource BrushBgRaised}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <TextBlock Text="🔍"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Margin="6,0,0,0"
                                               Foreground="{StaticResource BrushTextDim}"
                                               IsHitTestVisible="False"/>
                                    <TextBox x:Name="QuestSearchBox"
                                             Padding="22,3,6,3"
                                             FontSize="11"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             HorizontalAlignment="Stretch"
                                             ToolTip="{DynamicResource Main.Quests.Search.Tooltip}"
                                             TextChanged="QuestSearch_Changed"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="#0A0A0A"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                Padding="8,4,2,4"
                                MinHeight="120">
                            <ScrollViewer Style="{StaticResource DarkQuestScrollViewer}">
                                <StackPanel x:Name="QuestListPanel"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="16,0,16,8">
                        <TextBlock Style="{StaticResource HudLabel}" Text="{DynamicResource Main.Section.Shortcuts}"/>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Style="{StaticResource ShortcutChip}" Content="▣"
                                    FontSize="14"
                                    ToolTip="{DynamicResource Main.Shortcut.Overlay}"
                                    Click="ShowOverlay_Click"/>
                            <Button Style="{StaticResource ShortcutChip}" Content="☰"
                                    FontSize="14"
                                    ToolTip="{DynamicResource Main.Shortcut.Size}"
                                    Click="ToggleOverlayPanel_Click"/>
                            <Button Style="{StaticResource ShortcutChip}" Content="◎"
                                    FontSize="14"
                                    ToolTip="{DynamicResource Main.Shortcut.ItemLens}"
                                    Click="ItemLens_Click"/>
                            <Button Style="{StaticResource ShortcutChipInfo}" Content="↕"
                                    FontSize="14"
                                    ToolTip="{DynamicResource Main.Shortcut.Floor}"/>
                            <Button Style="{StaticResource ShortcutChipInfo}" Content="▦"
                                    FontSize="14"
                                    ToolTip="{DynamicResource Main.Shortcut.ItemScanIcon}"/>
                            <Button Style="{StaticResource ShortcutChipInfo}" Content="Aa"
                                    FontSize="12" FontWeight="SemiBold"
                                    ToolTip="{DynamicResource Main.Shortcut.ItemScanName}"/>
                            <Button Style="{StaticResource ShortcutChipInfo}" Content="⟲"
                                    FontSize="14"
                                    ToolTip="{DynamicResource Main.Shortcut.CleanupHint}"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Row="2" Padding="10,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{StaticResource IconOnlyButton}" Content="▣" Click="ShowOverlay_Click"
                                    ToolTip="{DynamicResource Main.Tooltip.ShowOverlay}" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource IconOnlyButton}" Content="◎" Click="ItemLens_Click"
                                    ToolTip="{DynamicResource Main.Tooltip.ItemLens}" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource IconOnlyButton}" Content="⌫" Click="EndRaid_Click"
                                    ToolTip="{DynamicResource Main.Tooltip.EndRaid}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="1" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource BrushBgPanel}">
                            <TextBlock x:Name="MapTitle" Text="{DynamicResource Main.MapPanel.Title}" VerticalAlignment="Center" Margin="12,0"
                                       Foreground="{StaticResource BrushAmber}" FontSize="12"/>
                        </Border>
                        <controls:MapView x:Name="PreviewMap" Grid.Row="1" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#000000" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
                <DockPanel Margin="12,0">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontSize="11" Foreground="{StaticResource BrushTextDim}"
                               Text="Anomaly Labs"/>
                    <TextBlock x:Name="Footer" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource BrushTextDim}"
                               Text="{DynamicResource Main.Footer.Tagline}"/>
                </DockPanel>
            </Border>
            </Grid>
        </Border>

        <Grid x:Name="SettingsOverlay" Panel.ZIndex="8000" Visibility="Collapsed">
            <Image x:Name="SettingsBlurShot" Stretch="Fill" IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="LowQuality"
                   RenderOptions.CachingHint="Cache">
                <Image.Effect>
                    <BlurEffect Radius="32" KernelType="Gaussian" RenderingBias="Performance"/>
                </Image.Effect>
            </Image>
            <Border Background="#73000000" MouseLeftButtonDown="SettingsScrim_Click"/>
            <Border x:Name="SettingsDrawer" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Width="440"
                    Background="{StaticResource BrushBgDeep}"
                    BorderBrush="{StaticResource BrushAmber}" BorderThickness="1,0,0,0"
                    MouseLeftButtonDown="SettingsDrawer_MouseDown">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SettingsDrawerShift" X="440"/>
                </Border.RenderTransform>
                <local:SettingsWindow x:Name="SettingsHost" VerticalAlignment="Stretch"/>
            </Border>
        </Grid>

        <Grid x:Name="LoadingOverlay" Panel.ZIndex="9999" Visibility="Visible" Background="#D9000000"
              IsHitTestVisible="False">
            <Image x:Name="LoadingSnapshot" Panel.ZIndex="0"
                   Stretch="Fill"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="LowQuality"
                   RenderOptions.CachingHint="Cache">
                <Image.Effect>
                    <BlurEffect Radius="28" RenderingBias="Performance"/>
                </Image.Effect>
            </Image>
            <Border Panel.ZIndex="1" Background="#80000000"/>
            <Border x:Name="LoadingTerminalPanel" Panel.ZIndex="2"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Margin="20,0,20,24" Padding="14,12" MinHeight="96"
                    Background="#E6101008" BorderBrush="{StaticResource BrushAmber}"
                    BorderThickness="1" MaxWidth="560" Opacity="1">
                <TextBlock x:Name="LoadingTerminalText"
                           FontFamily="Consolas" FontSize="14"
                           Foreground="{StaticResource BrushAmber}"
                           TextWrapping="Wrap" LineHeight="22"
                           Text="▌"/>
            </Border>
            <StackPanel Panel.ZIndex="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,28">
                <Ellipse Style="{StaticResource LoadingRingSmall}" Width="28" Height="28"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
