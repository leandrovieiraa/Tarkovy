<Window x:Class="Tarkovy.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tarkovy.Controls"
        Title="Tarkovy Overlay"
        Width="320" Height="348"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        ShowActivated="False"
        Icon="pack://application:,,,/Assets/brand/tarkovy.ico">
    <Border x:Name="MoveFrame"
            BorderBrush="#FFFFFF"
            BorderThickness="1"
            Padding="7"
            Cursor="SizeAll"
            MouseLeftButtonDown="Header_Drag">
        <Border.Background>
            <SolidColorBrush x:Name="GlassBrush" Color="#FF1A1A1A"/>
        </Border.Background>
        <Grid Cursor="Arrow">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#111111" Cursor="SizeAll" MouseLeftButtonDown="Header_Drag">
                <DockPanel>
                    <Image Source="pack://application:,,,/Assets/brand/tarkovy-icon-256.png"
                           Width="14" Height="14" Margin="8,0,6,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="OverlayTitle" Text="TARKOVY" VerticalAlignment="Center"
                               FontSize="11" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OverlayDragHint" DockPanel.Dock="Right" Text="{DynamicResource Overlay.DragHint}" Margin="0,0,8,0"
                               VerticalAlignment="Center" FontSize="9"
                               Foreground="#8A8A8A" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ExtractCol" Width="0"/>
                </Grid.ColumnDefinitions>
                <controls:MapView x:Name="OverlayMap"/>
                <Border Grid.Column="1" x:Name="ExtractPanel" Visibility="Collapsed"
                        Background="#0A0A0A" BorderBrush="#4A4A4A" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <StackPanel x:Name="ExtractList" Margin="8"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
