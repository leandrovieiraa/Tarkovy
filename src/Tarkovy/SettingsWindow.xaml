<UserControl x:Class="Tarkovy.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBgDeep}"
             Foreground="{StaticResource BrushText}">
    <Border BorderBrush="{StaticResource BrushAmber}" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <DockPanel Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/brand/tarkovy-icon-256.png"
                               Width="18" Height="18" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{DynamicResource Settings.Header}" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushAmber}" FontSize="16" FontWeight="Bold"
                                   FontFamily="{StaticResource HudFont}"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Width="36" Height="28" Click="Close_Click"
                            Background="Transparent" Foreground="{StaticResource BrushTextDim}" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Right"
                            ToolTip="{DynamicResource Main.Tooltip.Close}"/>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" Style="{StaticResource DarkQuestScrollViewer}"
                          VerticalScrollBarVisibility="Auto" Padding="18">
                <StackPanel>
                    <TextBlock Style="{StaticResource HudLabel}" Text="{DynamicResource Settings.Section.Language}"/>
                    <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged"/>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,18,0,4" Text="{DynamicResource Settings.Section.Windows}"/>
                    <CheckBox x:Name="StartWindowsBox" Content="{DynamicResource Settings.StartWithWindows}"/>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,18,0,4" Text="{DynamicResource Settings.Section.Logs}"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SlotButton}" Content="…" Width="40" Margin="8,0,0,0" Click="BrowseLogs_Click"/>
                        <TextBox x:Name="LogsPathBox"/>
                    </DockPanel>
                    <TextBlock x:Name="LogsOk" FontSize="11" Margin="0,4,0,0"/>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,14,0,4" Text="{DynamicResource Settings.Section.Shots}"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SlotButton}" Content="…" Width="40" Margin="8,0,0,0" Click="BrowseShots_Click"/>
                        <TextBox x:Name="ShotsPathBox"/>
                    </DockPanel>
                    <TextBlock x:Name="ShotsOk" FontSize="11" Margin="0,4,0,0"/>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,18,0,4" Text="{DynamicResource Settings.Section.Markers}"/>
                    <CheckBox x:Name="ShowExtractsBox" Content="{DynamicResource Settings.ShowExtracts}"/>
                    <CheckBox x:Name="ShowMinesBox" Content="{DynamicResource Settings.ShowMines}"/>
                    <CheckBox x:Name="ShowSpawnsBox" Content="{DynamicResource Settings.ShowSpawns}"/>
                    <CheckBox x:Name="ShowLabelsBox" Content="{DynamicResource Settings.ShowLabels}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{DynamicResource Settings.ShowLabelsHint}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{DynamicResource Settings.PoiHint}"/>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,18,0,4" Text="{DynamicResource Settings.Section.Map}"/>
                    <CheckBox x:Name="FollowBox" Content="{DynamicResource Settings.FollowPlayer}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{DynamicResource Settings.FollowPlayerHint}"/>
                    <CheckBox x:Name="AutoFloorBox" Content="{DynamicResource Settings.AutoFloorFromHeight}" Margin="0,10,0,0"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{DynamicResource Settings.AutoFloorFromHeightHint}"/>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,18,0,4" Text="{DynamicResource Settings.Section.Overlay}"/>
                    <TextBlock Style="{StaticResource HudLabel}" Text="{DynamicResource Settings.Opacity}"/>
                    <Slider x:Name="OpacitySlider" Minimum="0.45" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                    <CheckBox x:Name="DeleteBox" Content="{DynamicResource Settings.DeleteAfterRead}"/>
                    <CheckBox x:Name="KeepLastBox" Content="{DynamicResource Settings.KeepLast}"/>
                    <CheckBox x:Name="AutoCleanupBox" Content="{DynamicResource Settings.AutoCleanup}" Margin="0,8,0,0"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="{DynamicResource Settings.AutoCleanupHint}"/>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,18,0,4" Text="{DynamicResource Settings.Section.ItemLens}"/>
                    <CheckBox x:Name="ItemScanBox" Content="{DynamicResource Settings.ItemScanEnabled}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{DynamicResource Settings.ItemScanEnabledHint}"/>
                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,10,0,4" Text="{DynamicResource Settings.ItemLensOpacity}"/>
                    <Slider x:Name="ItemLensOpacitySlider" Minimum="0.5" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,14,0,4" Text="{DynamicResource Settings.ItemScanSlotSize}"/>
                    <ComboBox x:Name="ItemScanSlotCombo"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{DynamicResource Settings.ItemScanSlotSizeHint}"/>
                    <CheckBox x:Name="ItemScanRotatedBox" Content="{DynamicResource Settings.ItemScanRotated}" Margin="0,10,0,0"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{DynamicResource Settings.ItemScanRotatedHint}"/>

                    <CheckBox x:Name="ItemScanDebugBox" Content="{DynamicResource Settings.ItemScanDebug}" Margin="0,14,0,0"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{DynamicResource Settings.ItemScanDebugHint}"/>
                    <DockPanel Margin="0,6,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SlotButton}" Content="…" Width="40" Margin="8,0,0,0" Click="OpenItemScanDebug_Click"/>
                        <TextBox x:Name="ItemScanDebugPathBox" IsReadOnly="True"/>
                    </DockPanel>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,18,0,4" Text="{DynamicResource Settings.Section.ItemScanAi}"/>
                    <CheckBox x:Name="ItemScanAiBox" Content="{DynamicResource Settings.ItemScanAiEnabled}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{DynamicResource Settings.ItemScanAiHint}"/>
                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,10,0,4" Text="{DynamicResource Settings.ItemScanAiProvider}"/>
                    <ComboBox x:Name="ItemScanAiProviderCombo" SelectionChanged="ItemScanAiProviderCombo_SelectionChanged"/>
                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,10,0,4" Text="{DynamicResource Settings.ItemScanAiKey}"/>
                    <PasswordBox x:Name="ItemScanAiKeyBox"/>
                    <TextBlock x:Name="ItemScanAiKeyHintText" FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{DynamicResource Settings.ItemScanAiKeyHint}"/>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,18,0,4" Text="{DynamicResource Settings.Section.Squad}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="{DynamicResource Settings.Squad.Hint}"/>
                    <Button Style="{StaticResource SlotButton}" HorizontalAlignment="Left" Margin="0,0,0,10"
                            Content="{DynamicResource Settings.Squad.CopySql}" Click="SquadCopySql_Click"/>
                    <TextBlock Style="{StaticResource HudLabel}" Text="{DynamicResource Settings.Squad.Url}"/>
                    <TextBox x:Name="SquadUrlBox"/>
                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,10,0,4" Text="{DynamicResource Settings.Squad.AnonKey}"/>
                    <PasswordBox x:Name="SquadAnonKeyBox"/>
                    <Button Style="{StaticResource SlotButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Content="{DynamicResource Settings.Squad.Test}" Click="SquadTest_Click"/>
                    <TextBlock x:Name="SquadProjectStatusText" FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12">
                <DockPanel>
                    <TextBlock VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource BrushTextDim}"
                               Text="Anomaly Labs"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SlotButton}" Content="{DynamicResource Settings.Cancel}" Click="Close_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SlotButton}" Content="{DynamicResource Settings.Save}" Click="Save_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
