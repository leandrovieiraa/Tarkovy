<UserControl x:Class="Tarkovy.SquadWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBgDeep}"
             Foreground="{StaticResource BrushText}">
    <Border BorderBrush="{StaticResource BrushAmber}" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <DockPanel Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                            <Canvas Width="16" Height="16">
                                <Path Fill="{StaticResource BrushAmber}" Data="M3,1.3 H12.4 V14.7 H3 Z"/>
                                <Ellipse Width="2.1" Height="2.1" Canvas.Left="8.6" Canvas.Top="7.2" Fill="#111111"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{DynamicResource Squad.Header}" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushAmber}" FontSize="16" FontWeight="Bold"
                                   FontFamily="{StaticResource HudFont}"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Width="36" Height="28" Click="Close_Click"
                            Background="Transparent" Foreground="{StaticResource BrushTextDim}" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Right"
                            ToolTip="{DynamicResource Main.Tooltip.Close}"/>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" Style="{StaticResource DarkQuestScrollViewer}"
                          VerticalScrollBarVisibility="Auto" Padding="18">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap"
                               Text="{DynamicResource Squad.Panel.Hint}"/>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,16,0,4" Text="{DynamicResource Settings.Squad.AppKey}"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SlotButton}" Width="40" Height="32"
                                Margin="6,0,0,0" Padding="0" ToolTip="{DynamicResource Squad.CopyInvite.Tip}"
                                Click="SquadCopyInvite_Click">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M6,1.5 H14.5 V11 H11.8 V3.2 H6 Z"/>
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M1.5,5 H10 V14.5 H1.5 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <TextBox x:Name="SquadAppKeyBox" LostFocus="SquadAppKey_LostFocus"/>
                    </DockPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="{DynamicResource Settings.Squad.AppKeyHint}"/>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,16,0,4" Text="{DynamicResource Settings.Squad.Nick}"/>
                    <TextBox x:Name="SquadNickBox" LostFocus="SquadFields_LostFocus"/>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,10,0,4" Text="{DynamicResource Settings.Squad.Code}"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SlotButton}" Width="40" Height="32"
                                Margin="6,0,0,0" Padding="0" ToolTip="{DynamicResource Squad.Copy.Tip}"
                                Click="SquadCopy_Click">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M6,1.5 H14.5 V11 H11.8 V3.2 H6 Z"/>
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M1.5,5 H10 V14.5 H1.5 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SlotButton}" Width="40" Height="32"
                                Margin="6,0,0,0" Padding="0" ToolTip="{DynamicResource Squad.Generate.Tip}"
                                Click="SquadGenerateName_Click">
                            <Viewbox Width="14" Height="14">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Data="M13.2,6.4 A5.4,5.4 0 1 0 12.6,11.6 M13.2,6.4 L10.2,6.6 M13.2,6.4 L13.6,3.5"/>
                            </Viewbox>
                        </Button>
                        <TextBox x:Name="SquadCodeBox" CharacterCasing="Upper" LostFocus="SquadCode_LostFocus"
                                 TextChanged="SquadCode_TextChanged" FontWeight="SemiBold"/>
                    </DockPanel>

                    <TextBlock Style="{StaticResource HudLabel}" Margin="0,10,0,4" Text="{DynamicResource Settings.Squad.Password}"/>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="SquadPasswordEyeBtn" DockPanel.Dock="Right" Style="{StaticResource SlotButton}"
                                Width="40" Height="32" Margin="6,0,0,0" Padding="0"
                                Click="SquadPasswordEye_Click"
                                ToolTip="{DynamicResource Squad.Password.Show}">
                            <Grid>
                                <Viewbox x:Name="SquadEyeOpen" Width="15" Height="15">
                                    <Canvas Width="16" Height="16">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.45" Fill="Transparent"
                                              Data="M1.4,8 C1.4,8 4.2,3.2 8,3.2 C11.8,3.2 14.6,8 14.6,8 C14.6,8 11.8,12.8 8,12.8 C4.2,12.8 1.4,8 1.4,8 Z"/>
                                        <Ellipse Width="3.4" Height="3.4" Canvas.Left="6.3" Canvas.Top="6.3"
                                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Viewbox>
                                <Viewbox x:Name="SquadEyeSlash" Width="15" Height="15" Visibility="Collapsed">
                                    <Canvas Width="16" Height="16">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.45" Fill="Transparent"
                                              Data="M1.4,8 C1.4,8 4.2,3.2 8,3.2 C11.8,3.2 14.6,8 14.6,8 C14.6,8 11.8,12.8 8,12.8 C4.2,12.8 1.4,8 1.4,8 Z"/>
                                        <Ellipse Width="3.4" Height="3.4" Canvas.Left="6.3" Canvas.Top="6.3"
                                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round"
                                              Data="M2.4,13.4 L13.6,2.6"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Button>
                        <Grid>
                            <PasswordBox x:Name="SquadPasswordBox" PasswordChar="*" LostFocus="SquadFields_LostFocus"/>
                            <TextBox x:Name="SquadPasswordPlainBox" Visibility="Collapsed"
                                     LostFocus="SquadFields_LostFocus"/>
                        </Grid>
                    </DockPanel>

                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="SquadCreateBtn" Style="{StaticResource SlotButton}" Click="SquadCreate_Click" Margin="0,0,8,8" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="12" Height="12" Margin="0,0,7,0">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M7,1.5 H9 V7 H14.5 V9 H9 V14.5 H7 V9 H1.5 V7 H7 Z"/>
                                </Viewbox>
                                <TextBlock Text="{DynamicResource Settings.Squad.Create}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SlotButton}" Click="SquadJoin_Click" Margin="0,0,8,8" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                    <Canvas Width="16" Height="16">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"
                                              Data="M7.5,2.2 H14.2 V13.8 H7.5"/>
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Fill="Transparent"
                                              Data="M1.6,8 H10.4 M7.2,4.8 L10.4,8 L7.2,11.2"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{DynamicResource Settings.Squad.Join}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SlotButton}" Click="SquadLeave_Click" Margin="0,0,0,8" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                    <Canvas Width="16" Height="16">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"
                                              Data="M8.5,2.2 H1.8 V13.8 H8.5"/>
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Fill="Transparent"
                                              Data="M6.2,8 H14.4 M11.2,4.8 L14.4,8 L11.2,11.2"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{DynamicResource Settings.Squad.Leave}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <DockPanel Margin="0,6,0,0" LastChildFill="True">
                        <Ellipse x:Name="SquadStatusDot" DockPanel.Dock="Left" Width="8" Height="8"
                                 Margin="0,3,8,0" VerticalAlignment="Top"
                                 Fill="{StaticResource BrushTextDim}"/>
                        <TextBlock x:Name="SquadStatusText" FontSize="11" Foreground="{StaticResource BrushTextDim}"
                                   TextWrapping="Wrap"/>
                    </DockPanel>

                    <TextBlock x:Name="SquadMembersTitle" Style="{StaticResource HudLabel}" Margin="0,16,0,6"
                               Text="{DynamicResource Squad.Members}"/>
                    <Border Background="#0A0A0A"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Padding="8,6"
                            MinHeight="120">
                        <StackPanel x:Name="SquadMembersPanel"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
